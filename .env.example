# Copy to .env if you want to override defaults. All values are optional.
# Stage 1 needs NO API keys. Never commit your real .env file.

# Folder containing inventory.json and orders.json
# RELIABLEBIZ_DATA_DIR=data

# Folder for the JSON Lines request log
# RELIABLEBIZ_LOG_DIR=logs

# Longest user message accepted (20-5000)
# RELIABLEBIZ_MAX_INPUT_CHARS=500
